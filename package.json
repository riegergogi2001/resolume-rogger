{
  "name": "rogger",
  "productName": "ROGGER",
  "version": "2.2.4",
  "description": "Touchscreen OSC performance controller for Resolume and OSC-compatible software, with over-the-air updates — optimized for ASUS ROG Ally X.",
  "main": "src/bootstrap.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riegergogi2001/resolume-rogger.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "dist:win": "electron-builder --win --x64",
    "ma3": "python3 tools/gen-ma3-gdtf.py && python3 tools/gen-resolume-dmx-preset.py && python3 tools/gen-ma3-handoff.py",
    "payload": "node tools/build-payload.js",
    "release": "npm test && npm run payload && npm run dist:win",
    "verify:config": "node tools/verify-config.js",
    "check:live": "node tools/live-check.js",
    "audit:layout": "node tools/audit-layout.js"
  },
  "build": {
    "appId": "hu.rogger.controller",
    "productName": "ROGGER",
    "files": [
      "src/**/*",
      "configs/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ROGGER-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1"
  },
  "rogger": {
    "minShell": "2.1.0"
  }
}
