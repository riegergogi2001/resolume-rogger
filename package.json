{
  "name": "rogger",
  "productName": "ROGGER",
  "version": "1.18.0",
  "description": "Touchscreen OSC performance controller for Resolume and OSC-compatible software — optimized for ASUS ROG Ally X.",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riegergogi2001/resolume-rogger.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win --x64",
    "ma3": "python3 tools/gen-ma3-gdtf.py && python3 tools/gen-resolume-dmx-preset.py && python3 tools/gen-ma3-handoff.py"
  },
  "build": {
    "appId": "hu.rogger.controller",
    "productName": "ROGGER",
    "files": [
      "src/**/*",
      "configs/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ROGGER-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1"
  }
}
